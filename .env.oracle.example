# Oracle VM access
ORACLE_HOST=YOUR_ORACLE_PUBLIC_IP
ORACLE_SSH_USER=ubuntu
ORACLE_SSH_KEY=/absolute/path/to/your/oracle.key
ORACLE_REMOTE_DIR=/home/ubuntu/tienda-generica

# Compose project
COMPOSE_PROJECT_NAME=tienda-generica-oracle

# Public endpoints
FRONTEND_PUBLIC_BIND=0.0.0.0
FRONTEND_PUBLIC_PORT=80
BACKEND_PUBLIC_BIND=127.0.0.1
BACKEND_PUBLIC_PORT=8081
MYSQL_PUBLIC_BIND=127.0.0.1
MYSQL_PUBLIC_PORT=3306

# Application security
APP_SECURITY_TOKEN_SECRET=replace-this-with-a-long-random-secret
APP_CORS_ALLOWED_ORIGINS=http://YOUR_ORACLE_PUBLIC_IP,http://YOUR_ORACLE_PUBLIC_IP:80

# Database
MYSQL_DATABASE=tienda_generica
MYSQL_ROOT_PASSWORD=replace-this-mysql-password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/tienda_generica?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-this-mysql-password
