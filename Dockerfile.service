FROM maven:3.9-eclipse-temurin-17 AS build

ARG MODULE_PATH
ARG ARTIFACT_NAME

WORKDIR /app

COPY pom.xml ./
COPY mvnw ./
COPY .mvn .mvn
COPY microservices microservices

RUN chmod +x mvnw \
    && ./mvnw -q -DskipTests -pl "${MODULE_PATH}" -am package \
    && cp "/app/${MODULE_PATH}/target/${ARTIFACT_NAME}" /tmp/app-artifact

FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=build /tmp/app-artifact /app/app.war
COPY scripts /app/scripts

ENTRYPOINT ["java", "-jar", "/app/app.war"]
