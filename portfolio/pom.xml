<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.tiendagenerica</groupId>
    <artifactId>tienda-generica-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>portfolio</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.tiendagenerica</groupId>
      <artifactId>domain-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>../frontend/dist</directory><targetPath>static</targetPath></resource>
      <resource><directory>../scripts</directory><includes><include>demo-portafolio.sql</include></includes><targetPath>demo</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
        <executions><execution><id>report-sources</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
          <configuration><sources><source>../microservices/report-service/src/main/java</source></sources></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><includes>
          <include>**/portfolio/**/*.java</include><include>**/report/controller/*.java</include>
          <include>**/report/dto/*.java</include><include>**/report/service/*.java</include>
        </includes></configuration>
      </plugin>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
        <configuration><mainClass>com.tiendagenerica.portfolio.PortfolioApplication</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
